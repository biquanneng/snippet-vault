{
  "name": "snippet-vault-web",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "predev": "node scripts/generate-snippetvault-content-data.mjs",
    "dev": "next dev --port 3003",
    "prebuild": "node scripts/check-css-boundaries.mjs && node scripts/generate-snippetvault-content-data.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "pnpm lint && pnpm typecheck && pnpm build",
    "build:cloudflare": "node scripts/check-css-boundaries.mjs && node scripts/generate-snippetvault-content-data.mjs && opennextjs-cloudflare build",
    "preview": "pnpm build:cloudflare && opennextjs-cloudflare preview",
    "upload": "pnpm build:cloudflare && opennextjs-cloudflare upload",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "@opennextjs/cloudflare": "^1.9.2",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.5",
    "next-mdx-remote": "^6.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.40.0"
  }
}
