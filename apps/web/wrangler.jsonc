{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biqn-snippetvault",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://biqn.dev"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "biqn.dev/snippetvault*",
      "zone_name": "biqn.dev"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
